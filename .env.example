# =============================================================================
# Fuel Router - Environment Configuration Template
# Copy this file to .env.dev for local development or .env.prod for production.
# =============================================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=local-development-insecure-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# --- Database (PostGIS) ---
POSTGRES_DB=fuel_router
POSTGRES_USER=fuel_router
POSTGRES_PASSWORD=fuel_router
DATABASE_URL=postgis://fuel_router:fuel_router@db:5432/fuel_router

# --- Cache and Message Broker (Redis) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# --- Production Ingress and Gunicorn Concurrency ---
PORT=80
GUNICORN_WORKERS=4
GUNICORN_THREADS=2

# --- Routing Engine & External Geocoding ---
ROUTING_API_BASE_URL=https://router.project-osrm.org
ROUTING_API_KEY=
GDAL_LIBRARY_PATH=

# --- Vehicle & Corridor Optimization Parameters ---
MAX_RANGE_MILES=500
MPG_CONSTANT=10.0
CORRIDOR_BUFFER_MILES=15

# --- Fireworks AI (LLM Route Explanations) ---
# Optional: If empty or invalid, the system gracefully falls back to deterministic explanations.
FIREWORKS_API_KEY=
FIREWORKS_API_BASE_URL=https://api.fireworks.ai/inference/v1/chat/completions
FIREWORKS_LLM_MODEL_NAME=accounts/fireworks/models/deepseek-v4p1-flash
FIREWORKS_LLM_MODEL_NAE=
